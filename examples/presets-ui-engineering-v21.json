{
  "schema": "taskclosurekit/presets/v1",
  "presets": [
    {
      "id": "project-contract-tests",
      "executable": "/absolute/path/to/installed/bun",
      "argv": [
        "--cwd",
        "packages/contracts",
        "test",
        "src"
      ],
      "cwd_rule": "contract-repository",
      "environment_allowlist": {
        "PATH": "/usr/bin:/bin",
        "LC_ALL": "C"
      },
      "timeout": 5,
      "output_limit": 65536,
      "permitted_writes": [],
      "relevant_inputs": {
        "source": [
          "packages/contracts/src"
        ],
        "tests": [
          "packages/contracts/src"
        ],
        "manifests": [
          "package.json",
          "packages/contracts/package.json"
        ],
        "lockfiles": [
          "bun.lock"
        ],
        "config": [
          "packages/contracts/tsconfig.json"
        ]
      },
      "authority_inputs": [
        "packages/contracts/package.json"
      ],
      "runtime_inputs": []
    },
    {
      "id": "project-contract-typecheck",
      "executable": "/absolute/path/to/installed/node",
      "argv": [
        "/absolute/path/to/installed/typescript/lib/tsc.js",
        "--project",
        "packages/contracts/tsconfig.json",
        "--noEmit"
      ],
      "cwd_rule": "contract-repository",
      "environment_allowlist": {
        "PATH": "/usr/bin:/bin",
        "LC_ALL": "C"
      },
      "timeout": 5,
      "output_limit": 65536,
      "permitted_writes": [],
      "relevant_inputs": {
        "source": [
          "packages/contracts/src"
        ],
        "tests": [
          "packages/contracts/src"
        ],
        "manifests": [
          "package.json",
          "packages/contracts/package.json"
        ],
        "lockfiles": [
          "bun.lock"
        ],
        "config": [
          "packages/contracts/tsconfig.json"
        ]
      },
      "authority_inputs": [
        "packages/contracts/package.json"
      ],
      "runtime_inputs": [
        "/absolute/path/to/installed/typescript/lib/tsc.js"
      ]
    }
  ]
}
